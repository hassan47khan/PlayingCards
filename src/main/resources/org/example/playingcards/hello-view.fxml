<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>

<VBox spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.playingcards.HelloController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <!-- Top row: Find a Solution | solution field | Refresh -->
    <HBox alignment="CENTER" spacing="10.0">
        <Button text="Find a Solution" onAction="#onFindSolution"/>
        <TextField fx:id="tfSolution" editable="false" prefColumnCount="14" HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#onRefresh"/>
    </HBox>

    <!-- Four cards -->
    <HBox alignment="CENTER" spacing="10.0">
        <ImageView fx:id="card1" fitWidth="100.0" preserveRatio="true"/>
        <ImageView fx:id="card2" fitWidth="100.0" preserveRatio="true"/>
        <ImageView fx:id="card3" fitWidth="100.0" preserveRatio="true"/>
        <ImageView fx:id="card4" fitWidth="100.0" preserveRatio="true"/>
    </HBox>

    <!-- Bottom row: label | expression field | Verify (Enter in the field also verifies) -->
    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Enter an expression:">
            <font>
                <Font name="System Bold" size="13.0"/>
            </font>
        </Label>
        <TextField fx:id="tfExpression" onAction="#onVerify" HBox.hgrow="ALWAYS"/>
        <Button text="Verify" onAction="#onVerify"/>
    </HBox>
</VBox>